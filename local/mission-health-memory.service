[Unit]
Description=Mission Health text memory
After=network-online.target mission-health-qdrant.service
Wants=network-online.target
Requires=mission-health-qdrant.service
StartLimitIntervalSec=300
StartLimitBurst=3

[Service]
Type=simple
WorkingDirectory=%h/.local/share/mission-health
EnvironmentFile=%h/.config/mission-health/memory.env
Environment=MEMORY_MODE=hosted
Environment=MEMORY_HOST=127.0.0.1
Environment=MEMORY_PORT=8091
Environment=MEMORY_CPU_THREADS=2
Environment=MEMORY_BATCH_SIZE=1
Environment=MEMORY_MAX_TOKENS=1024
Environment=MEMORY_ENABLE_LOCAL_ASSISTANT=0
Environment=OMP_NUM_THREADS=2
Environment=MKL_NUM_THREADS=2
Environment=OPENBLAS_NUM_THREADS=2
Environment=TOKENIZERS_PARALLELISM=false
Environment=HF_HUB_OFFLINE=1
Environment=TRANSFORMERS_OFFLINE=1
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=%h/.local/share/mission-health/venv/bin/python %h/.local/share/mission-health/local/service.py
Restart=on-failure
RestartSec=10
TimeoutStartSec=180
TimeoutStopSec=30
MemoryHigh=2500M
MemoryMax=3G
CPUQuota=200%
TasksMax=128
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
UMask=0077

[Install]
WantedBy=default.target
